# Required for the live AI twin. Without it the site runs the built-in offline brain.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. Set to claude-sonnet-5-5 to roughly halve cost.
ANTHROPIC_MODEL=

# Optional. Comma-separated extra origins allowed to call /api/chat
# (thanos.cv, www.thanos.cv, *.vercel.app and localhost are always allowed).
ALLOWED_ORIGINS=
